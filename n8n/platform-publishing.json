{
  "name": "AIWithBh@i - Scheduled YouTube and Instagram Publishing",
  "nodes": [
    {
      "id": "pub-webhook",
      "name": "Publishing schedule webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "aiwithbhai-publishing",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "pub-normalize",
      "name": "Validate and split platform targets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "const e=$json.body??$json;\nif(e.event!=='video_scheduled'||!e.ownerId||!e.idea?.id||!e.idea?.videoStoragePath||!e.callback?.url) throw new Error('Invalid video_scheduled payload.');\nif(!Array.isArray(e.targets)||e.targets.length!==2) throw new Error('Exactly two platform targets are required.');\nconst seen=new Set();\nconst items=e.targets.map(t=>{\n  if(!t.id||!['youtube','instagram'].includes(t.platform)||!t.scheduledAt||!Number.isFinite(Date.parse(t.scheduledAt))) throw new Error('Invalid target.');\n  if(seen.has(t.platform)) throw new Error('Duplicate platform target.');\n  seen.add(t.platform);\n  return {json:{ownerId:e.ownerId,ideaId:e.idea.id,title:e.idea.title??'AIWithBh@i video',caption:e.idea.caption??e.idea.title??'',videoStoragePath:e.idea.videoStoragePath,scheduledAt:t.scheduledAt,targetId:t.id,platform:t.platform,callback:e.callback}};\n});\nif(!seen.has('youtube')||!seen.has('instagram')) throw new Error('Both YouTube and Instagram targets are required.');\nreturn items;"
      }
    },
    {
      "id": "pub-wait",
      "name": "Wait until platform schedule",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        700,
        300
      ],
      "parameters": {
        "resume": "specificTime",
        "dateTime": "={{$json.scheduledAt}}",
        "options": {}
      }
    },
    {
      "id": "pub-mark",
      "name": "Callback - publishing started",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$json.callback.url}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-publishing-callback-secret",
              "value": "={{$env.N8N_PUBLISHING_CALLBACK_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { ownerId:$json.ownerId, ideaId:$json.ideaId, platform:$json.platform, status:'publishing' } }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "pub-signed-url",
      "name": "Create temporary Supabase video URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL + '/storage/v1/object/sign/generated-videos/' + $json.videoStoragePath}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { expiresIn:3600 } }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "pub-attach-url",
      "name": "Build public video URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        300
      ],
      "parameters": {
        "jsCode": "const prev=$('Create temporary Supabase video URL').item.json; const signed=prev.signedURL??prev.signedUrl; if(!signed) throw new Error('Supabase did not return signedURL.'); const base=$env.SUPABASE_URL.replace(/\\/$/,''); const url=signed.startsWith('http')?signed:base+'/storage/v1'+(signed.startsWith('/')?signed:'/'+signed); return [{json:{...$json,videoUrl:url}}];"
      }
    },
    {
      "id": "pub-switch",
      "name": "Route by platform",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1660,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.platform}}",
                    "rightValue": "youtube",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "youtube"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.platform}}",
                    "rightValue": "instagram",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "instagram"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "yt-download",
      "name": "Download video for YouTube",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1900,
        180
      ],
      "parameters": {
        "url": "={{$json.videoUrl}}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      }
    },
    {
      "id": "yt-upload",
      "name": "Upload YouTube video",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [
        2140,
        180
      ],
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{$('Build public video URL').item.json.title}}",
        "regionCode": "IN",
        "categoryId": "28",
        "binaryPropertyName": "data",
        "options": {
          "privacyStatus": "public"
        }
      }
    },
    {
      "id": "ig-create",
      "name": "Create Instagram Reel container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1900,
        440
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.META_GRAPH_API_VERSION ? 'https://graph.facebook.com/' + $env.META_GRAPH_API_VERSION + '/' + $env.INSTAGRAM_BUSINESS_ACCOUNT_ID + '/media' : 'https://graph.facebook.com/v24.0/' + $env.INSTAGRAM_BUSINESS_ACCOUNT_ID + '/media'}}",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "media_type",
              "value": "REELS"
            },
            {
              "name": "video_url",
              "value": "={{$('Build public video URL').item.json.videoUrl}}"
            },
            {
              "name": "caption",
              "value": "={{$('Build public video URL').item.json.caption}}"
            },
            {
              "name": "share_to_feed",
              "value": "true"
            },
            {
              "name": "access_token",
              "value": "={{$env.INSTAGRAM_ACCESS_TOKEN}}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "ig-wait",
      "name": "Initial Instagram processing wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2120,
        440
      ],
      "parameters": {
        "amount": 90,
        "unit": "seconds"
      }
    },
    {
      "id": "ig-publish",
      "name": "Publish Instagram Reel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2380,
        440
      ],
      "parameters": {
        "method": "POST",
        "url": "={{'https://graph.facebook.com/' + ($env.META_GRAPH_API_VERSION || 'v24.0') + '/' + $env.INSTAGRAM_BUSINESS_ACCOUNT_ID + '/media_publish'}}",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "creation_id",
              "value": "={{$('Create Instagram Reel container').item.json.id}}"
            },
            {
              "name": "access_token",
              "value": "={{$env.INSTAGRAM_ACCESS_TOKEN}}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "yt-callback",
      "name": "Callback - YouTube published",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2380,
        180
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$('Build public video URL').item.json.callback.url}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-publishing-callback-secret",
              "value": "={{$env.N8N_PUBLISHING_CALLBACK_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { ownerId:$('Build public video URL').item.json.ownerId, ideaId:$('Build public video URL').item.json.ideaId, platform:'youtube', status:'published', platformPostId:$json.id, publishedUrl:'https://www.youtube.com/watch?v='+$json.id } }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "ig-callback",
      "name": "Callback - Instagram published",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2620,
        440
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$('Build public video URL').item.json.callback.url}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-publishing-callback-secret",
              "value": "={{$env.N8N_PUBLISHING_CALLBACK_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { ownerId:$('Build public video URL').item.json.ownerId, ideaId:$('Build public video URL').item.json.ideaId, platform:'instagram', status:'published', platformPostId:$json.id, publishedUrl:'https://www.instagram.com/' } }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "ig-poll-start",
      "name": "Initialize Instagram processing poll",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2120,
        600
      ],
      "parameters": {
        "jsCode": "return [{json:{...$json,creationId:$json.id,pollAttempt:1}}];"
      }
    },
    {
      "id": "ig-status",
      "name": "Check Instagram Reel processing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2360,
        600
      ],
      "parameters": {
        "method": "GET",
        "url": "={{'https://graph.facebook.com/' + ($env.META_GRAPH_API_VERSION || 'v24.0') + '/' + $json.creationId}}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "status_code"
            },
            {
              "name": "access_token",
              "value": "={{$env.INSTAGRAM_ACCESS_TOKEN}}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "ig-evaluate",
      "name": "Evaluate Instagram processing status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2600,
        600
      ],
      "parameters": {
        "jsCode": "const wait=$('Wait before Instagram status check').item.json; const status=$json.status_code; return [{json:{...$('Build public video URL').item.json,creationId:wait.creationId,pollAttempt:Number(wait.pollAttempt||1),statusCode:status}}];"
      }
    },
    {
      "id": "ig-status-switch",
      "name": "Instagram processing result",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        2840,
        600
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.statusCode}}",
                    "rightValue": "FINISHED",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "finished"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.statusCode}}",
                    "rightValue": "ERROR",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "error"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "id": "ig-poll-limit",
      "name": "Check Instagram poll limit",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3080,
        760
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{$json.pollAttempt}}",
              "rightValue": 20,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ig-poll-wait",
      "name": "Wait before Instagram status check",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        3320,
        760
      ],
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      }
    },
    {
      "id": "ig-increment",
      "name": "Increment Instagram poll attempt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3560,
        760
      ],
      "parameters": {
        "jsCode": "return [{json:{...$json,pollAttempt:Number($json.pollAttempt||1)+1}}];"
      }
    },
    {
      "id": "ig-failed-callback",
      "name": "Callback - Instagram publishing failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3320,
        980
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$('Build public video URL').item.json.callback.url}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-publishing-callback-secret",
              "value": "={{$env.N8N_PUBLISHING_CALLBACK_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { ownerId:$('Build public video URL').item.json.ownerId, ideaId:$('Build public video URL').item.json.ideaId, platform:'instagram', status:'failed', error:$json.statusCode==='ERROR'?'Instagram rejected Reel processing':'Instagram processing timed out after 20 checks' } }}",
        "options": {
          "timeout": 30000
        }
      }
    }
  ],
